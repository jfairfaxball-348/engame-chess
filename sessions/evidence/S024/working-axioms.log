@EndgameChess.Rules.krk_strong_to_move_live : ∀ {p q : EndgameChess.Rules.Position} {σ : EndgameChess.KK.Colour}
  {sk rs wk : EndgameChess.KK.Square},
  EndgameChess.Rules.Legal p q → EndgameChess.Rules.IsKRK q σ sk rs wk → q.turn = σ → ¬EndgameChess.Rules.DeadK q
@EndgameChess.Rules.krk_dead_iff : ∀ {q : EndgameChess.Rules.Position} {σ : EndgameChess.KK.Colour}
  {sk rs wk : EndgameChess.KK.Square},
  EndgameChess.Rules.IsKRK q σ sk rs wk →
    q.turn = σ.opp →
      (EndgameChess.Rules.DeadK q ↔
        ¬EndgameChess.Rules.MatedK q ∧
          ∀ (r : EndgameChess.Rules.Position), EndgameChess.Rules.Legal q r → ∃ w b, EndgameChess.Rules.IsKK r w b)
@EndgameChess.Rules.arisen_krk_strong_live : ∀ {q : EndgameChess.Rules.Position} {σ : EndgameChess.KK.Colour}
  {sk rs wk : EndgameChess.KK.Square},
  EndgameChess.Rules.Arisen q → EndgameChess.Rules.IsKRK q σ sk rs wk → q.turn = σ → ¬EndgameChess.Rules.DeadK q
@EndgameChess.Rules.krk_drawn_by_rule_iff : ∀ {q : EndgameChess.Rules.Position} {σ : EndgameChess.KK.Colour}
  {sk rs wk : EndgameChess.KK.Square},
  EndgameChess.Rules.Arisen q →
    EndgameChess.Rules.IsKRK q σ sk rs wk →
      (EndgameChess.Rules.Rule5_2_2 q EndgameChess.Rules.GameResult.draw ↔
        q.turn = σ.opp ∧
          ¬EndgameChess.Rules.MatedK q ∧
            ∀ (r : EndgameChess.Rules.Position), EndgameChess.Rules.Legal q r → ∃ w b, EndgameChess.Rules.IsKK r w b)
@EndgameChess.Rules.krk_live_of_not_check : ∀ {q : EndgameChess.Rules.Position} {σ : EndgameChess.KK.Colour}
  {sk rs wk : EndgameChess.KK.Square},
  EndgameChess.Rules.IsKRK q σ sk rs wk →
    q.turn = σ → EndgameChess.Rules.inCheck q σ.opp = false → ¬EndgameChess.Rules.DeadK q
