EndgameChess.Rules.pursuit_absDiff : ∀ (d : Bool) (s t : EndgameChess.KK.Square),
  EndgameChess.KK.absDiff (EndgameChess.Rules.pursuitFile d s) (EndgameChess.Rules.pursuitFile d t) =
    EndgameChess.KK.absDiff ↑s.fst ↑t.fst
EndgameChess.Rules.wall_far_margin : ∀ (w : Fin 8), 4 ≤ EndgameChess.KK.absDiff ↑(EndgameChess.Rules.wallFarFile w) ↑w
EndgameChess.Rules.wall_wait_choice : ∀ (r w : Fin 8),
  EndgameChess.Rules.wallWaitFile r w ≠ r ∧ 3 ≤ EndgameChess.KK.absDiff ↑(EndgameChess.Rules.wallWaitFile r w) ↑w
@EndgameChess.Rules.krk_wall_rook_move : ∀ {q : EndgameChess.Rules.Position} {σ : EndgameChess.KK.Colour}
  {sk rs wk nr : EndgameChess.KK.Square},
  EndgameChess.Rules.Matches q σ { sk := sk, rs := rs, wk := wk, strong := true } →
    ↑sk.snd < ↑rs.snd →
      ↑rs.snd < ↑wk.snd →
        nr.snd = rs.snd →
          nr ≠ rs →
            3 ≤ EndgameChess.KK.absDiff ↑nr.fst ↑wk.fst →
              ∃ c,
                EndgameChess.Rules.Legal q c ∧
                  EndgameChess.Rules.Matches c σ { sk := sk, rs := nr, wk := wk, strong := false } ∧
                    (∃ r, EndgameChess.Rules.Legal c r) ∧
                      ∀ (r : EndgameChess.Rules.Position),
                        EndgameChess.Rules.Legal c r →
                          ∃ t,
                            EndgameChess.Rules.Matches r σ { sk := sk, rs := nr, wk := t, strong := true } ∧
                              ↑rs.snd < ↑t.snd ∧
                                2 ≤ EndgameChess.KK.absDiff ↑nr.fst ↑t.fst ∧
                                  EndgameChess.KK.absDiff ↑t.fst ↑wk.fst ≤ 1 ∧
                                    (↑wk.snd = ↑rs.snd + 1 →
                                      ↑rs.snd + 2 ≤ ↑t.snd ∨
                                        ↑t.snd = ↑rs.snd + 1 ∧ EndgameChess.KK.absDiff ↑t.fst ↑wk.fst = 1)
@EndgameChess.Rules.lower_band_reply_shape : ∀ {sk rs wk t : EndgameChess.KK.Square},
  ↑sk.snd + 1 = ↑rs.snd →
    ↑wk.snd = ↑rs.snd + 1 →
      EndgameChess.Rules.StepM { sk := sk, rs := rs, wk := wk, strong := false }
          { sk := sk, rs := rs, wk := t, strong := true } →
        ↑rs.snd + 2 ≤ ↑t.snd ∨ ↑t.snd = ↑rs.snd + 1 ∧ EndgameChess.KK.absDiff ↑t.fst ↑wk.fst = 1
EndgameChess.Rules.pursuit_king_step : ∀ (d : Bool) {sk rs wk : EndgameChess.KK.Square},
  ↑sk.snd + 1 = ↑rs.snd →
    ↑wk.snd = ↑rs.snd + 1 →
      EndgameChess.Rules.pursuitFile d sk + 2 ≤ EndgameChess.Rules.pursuitFile d wk →
        ∃ su,
          su.snd = sk.snd ∧
            EndgameChess.Rules.pursuitFile d su = EndgameChess.Rules.pursuitFile d sk + 1 ∧
              EndgameChess.Rules.StepM { sk := sk, rs := rs, wk := wk, strong := true }
                { sk := su, rs := rs, wk := wk, strong := false }
EndgameChess.Rules.krk_pursuit_king_move : ∀ (d : Bool) {q : EndgameChess.Rules.Position} {σ : EndgameChess.KK.Colour}
  {sk rs wk : EndgameChess.KK.Square},
  EndgameChess.Rules.Matches q σ { sk := sk, rs := rs, wk := wk, strong := true } →
    ↑sk.snd + 1 = ↑rs.snd →
      ↑wk.snd = ↑rs.snd + 1 →
        EndgameChess.Rules.pursuitFile d sk + 2 ≤ EndgameChess.Rules.pursuitFile d wk →
          3 ≤ EndgameChess.KK.absDiff ↑rs.fst ↑wk.fst →
            ∃ su c,
              su.snd = sk.snd ∧
                EndgameChess.Rules.pursuitFile d su = EndgameChess.Rules.pursuitFile d sk + 1 ∧
                  EndgameChess.Rules.Legal q c ∧
                    EndgameChess.Rules.Matches c σ { sk := su, rs := rs, wk := wk, strong := false } ∧
                      (∃ r, EndgameChess.Rules.Legal c r) ∧
                        ∀ (r : EndgameChess.Rules.Position),
                          EndgameChess.Rules.Legal c r →
                            ∃ t,
                              EndgameChess.Rules.Matches r σ { sk := su, rs := rs, wk := t, strong := true } ∧
                                2 ≤ EndgameChess.KK.absDiff ↑rs.fst ↑t.fst ∧
                                  EndgameChess.KK.absDiff ↑t.fst ↑wk.fst ≤ 1 ∧
                                    (↑rs.snd + 2 ≤ ↑t.snd ∨
                                      ↑t.snd = ↑rs.snd + 1 ∧ EndgameChess.KK.absDiff ↑t.fst ↑wk.fst = 1)
@EndgameChess.Rules.opposition_check_step_two : ∀ {sk rs wk : EndgameChess.KK.Square},
  EndgameChess.Rules.Opposed sk wk →
    2 ≤ EndgameChess.KK.absDiff ↑rs.fst ↑wk.fst →
      ↑rs.snd ≠ ↑wk.snd →
        EndgameChess.Rules.StepM { sk := sk, rs := rs, wk := wk, strong := true }
          { sk := sk, rs := EndgameChess.Rules.checkRook rs wk, wk := wk, strong := false }
@EndgameChess.Rules.krk_opposition_check_two : ∀ {q : EndgameChess.Rules.Position} {σ : EndgameChess.KK.Colour}
  {sk rs wk : EndgameChess.KK.Square},
  EndgameChess.Rules.Matches q σ { sk := sk, rs := rs, wk := wk, strong := true } →
    EndgameChess.Rules.Opposed sk wk →
      2 ≤ EndgameChess.KK.absDiff ↑rs.fst ↑wk.fst →
        ↑rs.snd ≠ ↑wk.snd →
          ∃ c,
            EndgameChess.Rules.Legal q c ∧
              EndgameChess.Rules.Matches c σ
                  { sk := sk, rs := EndgameChess.Rules.checkRook rs wk, wk := wk, strong := false } ∧
                (EndgameChess.Rules.MateGoal σ c ∨
                  (∃ r, EndgameChess.Rules.Legal c r) ∧
                    ∀ (r : EndgameChess.Rules.Position),
                      EndgameChess.Rules.Legal c r →
                        ∃ t,
                          EndgameChess.Rules.Matches r σ
                              { sk := sk, rs := EndgameChess.Rules.checkRook rs wk, wk := t, strong := true } ∧
                            ↑t.snd = ↑wk.snd + 1 ∧ EndgameChess.KK.absDiff ↑t.fst ↑wk.fst ≤ 1)
@EndgameChess.Rules.krk_two_file_edge_force : ∀ {q : EndgameChess.Rules.Position} {σ : EndgameChess.KK.Colour}
  {sk rs wk : EndgameChess.KK.Square},
  EndgameChess.Rules.Matches q σ { sk := sk, rs := rs, wk := wk, strong := true } →
