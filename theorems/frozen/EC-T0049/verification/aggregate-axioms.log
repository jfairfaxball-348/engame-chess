    EndgameChess.Rules.isLegal EndgameChess.Rules.lowerCheck (EndgameChess.Rules.mv✝ 2 3 2 2) = true
EndgameChess.Rules.two_file_rank_raise_needs_rescue : EndgameChess.Rules.PhaseImage (EndgameChess.Rules.sq✝ 0 1)
    (EndgameChess.Rules.sq✝ 4 2) (EndgameChess.Rules.sq✝ 2 4) ∧
  EndgameChess.Rules.isLegal EndgameChess.Rules.upperBefore (EndgameChess.Rules.mv✝ 4 2 4 3) = true ∧
    EndgameChess.Rules.isLegal EndgameChess.Rules.upperRaised (EndgameChess.Rules.mv✝ 2 4 3 4) = true ∧
      ¬EndgameChess.Rules.SafeRook (EndgameChess.Rules.sq✝ 0 1) (EndgameChess.Rules.sq✝ 4 3)
            (EndgameChess.Rules.sq✝ 3 4) ∧
        EndgameChess.Rules.isLegal EndgameChess.Rules.upperHanging (EndgameChess.Rules.mv✝ 4 3 7 3) = true
