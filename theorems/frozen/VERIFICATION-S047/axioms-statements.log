            EndgameChess.Rules.isLegal EndgameChess.Rules.chaseB (EndgameChess.Rules.mv✝ 2 1 1 1) = true ∧
              EndgameChess.Rules.isLegal EndgameChess.Rules.chaseKingLeft (EndgameChess.Rules.mv✝ 1 3 2 3) = true ∧
                EndgameChess.Rules.PhaseImage (EndgameChess.Rules.sq✝ 1 1) (EndgameChess.Rules.sq✝ 7 2)
                    (EndgameChess.Rules.sq✝ 2 3) ∧
                  EndgameChess.Rules.PhaseImage (EndgameChess.Rules.sq✝ 2 1) (EndgameChess.Rules.sq✝ 7 2)
                      (EndgameChess.Rules.sq✝ 1 3) ∧
