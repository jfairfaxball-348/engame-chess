def EndgameChess.Rules.RawRepetition.LegalEP : EndgameChess.Rules.Position → EndgameChess.Rules.Move → Prop :=
fun q m =>
  EndgameChess.Rules.isLegal q m = true ∧
    EndgameChess.Rules.RawClock.Pawn q m ∧
      q.ep = some m.dst ∧
        m.src.fst ≠ m.dst.fst ∧
          q.board m.dst = none ∧
            q.board (m.dst.fst, m.src.snd) = some { colour := q.turn.opp, kind := EndgameChess.Rules.PieceType.pawn }
