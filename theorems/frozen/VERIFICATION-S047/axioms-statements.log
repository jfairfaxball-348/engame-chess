      2 ≤ EndgameChess.KK.absDiff ↑rs.fst ↑wk.fst → ↑rs.snd ≠ ↑wk.snd → ↑wk.snd = 7 → EndgameChess.Rules.ForceMate σ q
EndgameChess.Rules.pursuit_tempo_return_margin : ∀ (d : Bool) {sk wk t : EndgameChess.KK.Square} {rs : Fin 8},
  EndgameChess.Rules.pursuitFile d wk = EndgameChess.Rules.pursuitFile d sk + 2 →
    EndgameChess.Rules.pursuitFile d t = EndgameChess.Rules.pursuitFile d sk + 1 →
      rs = EndgameChess.Rules.wallFarFile wk.fst →
        3 ≤ EndgameChess.KK.absDiff ↑(EndgameChess.Rules.wallWaitFile rs t.fst) ↑wk.fst
EndgameChess.Rules.pursuit_file_eq : ∀ (d : Bool) {s t : EndgameChess.KK.Square},
  EndgameChess.Rules.pursuitFile d s = EndgameChess.Rules.pursuitFile d t → ↑s.fst = ↑t.fst
@EndgameChess.Rules.pursuit_margin_step : ∀ {a b c : EndgameChess.KK.Square} {k : Nat},
  k + 1 ≤ EndgameChess.KK.absDiff ↑a.fst ↑b.fst →
    EndgameChess.KK.absDiff ↑c.fst ↑b.fst ≤ 1 → k ≤ EndgameChess.KK.absDiff ↑a.fst ↑c.fst
EndgameChess.Rules.krk_oriented_lower_pursuit : ∀ (d : Bool) {σ : EndgameChess.KK.Colour} {y : Nat},
  EndgameChess.Rules.LowerExitWins σ y →
    ∀ {q : EndgameChess.Rules.Position} {sk rs wk : EndgameChess.KK.Square},
      EndgameChess.Rules.Matches q σ { sk := sk, rs := rs, wk := wk, strong := true } →
        ↑sk.snd + 1 = y →
          ↑rs.snd = y →
            ↑wk.snd = y + 1 →
              2 ≤ EndgameChess.KK.absDiff ↑rs.fst ↑wk.fst →
                EndgameChess.Rules.pursuitFile d sk < EndgameChess.Rules.pursuitFile d wk →
                  EndgameChess.Rules.ForceMate σ q
@EndgameChess.Rules.krk_lower_band_force_of_exits : ∀ {σ : EndgameChess.KK.Colour} {y : Nat},
