EndgameChess.Rules.phase_image_chase_cycle : EndgameChess.Rules.isLegal EndgameChess.Rules.chaseStart
      (EndgameChess.Rules.mv✝ 7 0 7 2) =
    true ∧
  EndgameChess.Rules.isLegal EndgameChess.Rules.chaseCheck (EndgameChess.Rules.mv✝ 1 2 1 3) = true ∧
    EndgameChess.Rules.isLegal EndgameChess.Rules.chaseFirst (EndgameChess.Rules.mv✝ 1 0 1 1) = true ∧
