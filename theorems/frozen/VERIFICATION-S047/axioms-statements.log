  EndgameChess.Rules.isLegal EndgameChess.Rules.cornerBefore (EndgameChess.Rules.mv✝ 0 6 6 6) = true ∧
    EndgameChess.Rules.inCheck EndgameChess.Rules.cornerAfter EndgameChess.KK.Colour.black = false ∧
