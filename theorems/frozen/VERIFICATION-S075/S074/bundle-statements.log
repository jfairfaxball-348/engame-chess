    ∀ (g : EndgameChess.Rules.BoardSym) {q : EndgameChess.Rules.Position} {sk rs wk : EndgameChess.KK.Square},
      EndgameChess.Rules.Matches q σ { sk := sk, rs := rs, wk := wk, strong := true } →
        ↑(g.f sk).snd + 2 ≤ ↑(g.f wk).snd →
          ↑(g.f rs).fst ≠ ↑(g.f sk).fst ∨ ↑(g.f sk).snd < ↑(g.f rs).snd →
            2 ≤ EndgameChess.KK.absDiff ↑(g.f rs).fst ↑(g.f wk).fst → EndgameChess.Rules.MateWithin σ (B + 2) q

